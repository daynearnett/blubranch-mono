# --- API server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# Local docker-compose default — see docker-compose.yml
DATABASE_URL=postgresql://blubranch:blubranch@localhost:5432/blubranch?schema=public

# --- Cache / queues ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=replace-me-with-a-long-random-string

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Publishable key handed to the mobile Payment Sheet (pk_test_… / pk_live_…)
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Recurring Price ids for the monthly subscription tiers (create in Stripe dashboard)
STRIPE_PRICE_PRO=price_replace_me
STRIPE_PRICE_UNLIMITED=price_replace_me
# Mobile build also needs this as a public env var (apps/mobile/.env or EAS):
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACreplace_me
TWILIO_AUTH_TOKEN=replace_me

# --- Email (Resend) ---
RESEND_API_KEY=re_replace_me

# --- Twilio Verify (phone verification on apply flow) ---
TWILIO_VERIFY_SERVICE_SID=VA_replace_me

# --- Push notifications (Firebase Cloud Messaging) ---
FIREBASE_PROJECT_ID=blubranch-dev
# Stringified Firebase service account JSON — used by firebase-admin
FIREBASE_SERVICE_ACCOUNT_JSON={}

# --- Google Maps / geocoding ---
GOOGLE_MAPS_API_KEY=replace_me

# --- Social sign-in (id_token verification) ---
# Apple: allowed audiences for the id_token `aud` claim. Defaults to the iOS
# bundle id (com.blubranch.app) when unset; add a web Services ID if used.
APPLE_CLIENT_IDS=com.blubranch.app
# Google: comma-separated OAuth client ids from Google Cloud console. Include the
# WEB client id (used as serverClientId by the mobile lib → becomes the idToken
# `aud`) and optionally the iOS client id. Unset = Google sign-in disabled.
GOOGLE_CLIENT_IDS=replace_me.apps.googleusercontent.com

# --- Error monitoring (Sentry) ---
# Unset = Sentry disabled (the app runs identically without it). Create a project
# at sentry.io, use its Node/Fastify DSN here. Optional tuning below.
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=            # defaults to RAILWAY_GIT_COMMIT_SHA when present

# --- Content moderation (OpenAI omni-moderation, free) ---
# Auto-blocks high-confidence explicit/violent text + images on post/upload.
# Unset = moderation disabled (fail-open). Get a key at platform.openai.com.
OPENAI_API_KEY=sk-replace_me

# --- Onboarding profile import ---
# LinkedIn ("Sign In with LinkedIn using OpenID Connect" product). Unset =
# the LinkedIn option hides in onboarding. Note the scopes only return name,
# photo and email — LinkedIn has not exposed work history or skills to new
# apps since Aug 2023, which is why the resume import below exists.
LINKEDIN_CLIENT_ID=replace_me
LINKEDIN_CLIENT_SECRET=replace_me
# Must match an "Authorized redirect URL" on the LinkedIn app verbatim.
# Defaults to <PUBLIC_API_URL>/auth/linkedin/callback.
# LINKEDIN_REDIRECT_URI=https://api-staging.blubranch.com/auth/linkedin/callback
# Public origin of this API, used to build the redirect URI above.
PUBLIC_API_URL=https://api-staging.blubranch.com
# Deep-link scheme the LinkedIn callback bounces back into. Matches app.json.
# APP_URL_SCHEME=blubranch

# --- Resume import + AI copy (Anthropic) ---
# Parses an uploaded resume PDF into work history, skills, headline and bio.
# Unset = the resume option hides and the endpoint 503s.
ANTHROPIC_API_KEY=sk-ant-replace_me
